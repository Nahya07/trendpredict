# Copy to .env and fill in what you have. Nothing here needs to be filled in to run the
# app in DEMO DATA MODE — every provider below degrades gracefully to demo data when
# disabled or missing credentials (see docs/ROADMAP.md).

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://trendpredict:trendpredict@localhost:5432/trendpredict
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-to-a-32-byte-random-string

# --- Shopee Affiliate Open API (official) ---
SHOPEE_API_ENABLED=false
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_AFFILIATE_ID=
SHOPEE_ACCESS_TOKEN=
SHOPEE_REFRESH_TOKEN=
SHOPEE_API_REGION=id
SHOPEE_API_ENVIRONMENT=production
SHOPEE_WEBHOOK_SECRET=

# --- Google Trends (via BigQuery public dataset — see docs/API_RESEARCH.md) ---
GOOGLE_TRENDS_ENABLED=false
GCP_PROJECT_ID=
GCP_KEY_JSON=

# --- News provider (bring your own licensed news search API) ---
NEWS_ENABLED=false
NEWS_API_KEY=
NEWS_API_BASE_URL=

# --- Social signal provider (bring your own licensed social-listening API) ---
SOCIAL_SIGNAL_ENABLED=false
SOCIAL_API_KEY=
SOCIAL_API_BASE_URL=

# --- App behavior ---
DEMO_MODE_BANNER=true
